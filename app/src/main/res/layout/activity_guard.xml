<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="@color/bg"
    android:padding="28dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🛡"
        android:textSize="48sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:text="Moto Guard"
        android:textColor="@color/text"
        android:textSize="24sp"
        android:textStyle="bold"
        android:letterSpacing="0.05" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="SMS gateway · kiosk"
        android:textColor="@color/muted"
        android:textSize="13sp" />

    <!-- Public: no PIN. The whole point of the box — reachable at the glass. -->
    <Button
        android:id="@+id/openSms"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:layout_marginTop="32dp"
        android:background="@drawable/btn_primary"
        android:text="Open SMS Gateway"
        android:textStyle="bold"
        android:textAllCaps="false"
        android:textColor="@color/onAccent" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:layout_marginTop="24dp"
        android:padding="24dp"
        android:background="@drawable/bg_card">

        <EditText
            android:id="@+id/pin"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="@drawable/bg_field"
            android:inputType="numberPassword"
            android:gravity="center"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:letterSpacing="0.3"
            android:hint="enter PIN" />

        <Button
            android:id="@+id/unlock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/btn_primary"
            android:text="Unlock"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/onAccent" />

        <TextView
            android:id="@+id/msg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textColor="@color/danger"
            android:textSize="13sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:text="Admin access via scrcpy / adb"
        android:textColor="@color/muted"
        android:textSize="11sp" />
</LinearLayout>
