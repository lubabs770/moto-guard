<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0B0B10"
    android:padding="32dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="LOCKED"
        android:textColor="#5CE1A5"
        android:textSize="34sp"
        android:letterSpacing="0.2"
        android:textStyle="bold" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Administered device. Access via scrcpy / adb."
        android:textColor="#6B6B7B"
        android:textSize="14sp" />

    <!-- Hidden-ish escape trigger: tap this to open PIN entry.
         Small + dim on purpose so it's not an obvious touch target. -->
    <View
        android:id="@+id/unlockTap"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_marginTop="80dp"
        android:background="#00000000" />
</LinearLayout>
