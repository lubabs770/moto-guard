<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#0B0B10"
    android:padding="32dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Enter code"
        android:textColor="#C9C9D4"
        android:textSize="16sp" />

    <EditText
        android:id="@+id/pin"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:inputType="numberPassword"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textColorHint="#555566"
        android:hint="current PIN" />

    <!-- New-PIN fields, revealed only after the current PIN checks out. -->
    <EditText
        android:id="@+id/newPin"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:inputType="numberPassword"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textColorHint="#555566"
        android:hint="new PIN"
        android:visibility="gone" />

    <EditText
        android:id="@+id/confirmPin"
        android:layout_width="220dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:inputType="numberPassword"
        android:gravity="center"
        android:textColor="#FFFFFF"
        android:textColorHint="#555566"
        android:hint="confirm new PIN"
        android:visibility="gone" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:orientation="horizontal">

        <Button
            android:id="@+id/release"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Release" />

        <Button
            android:id="@+id/changePin"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:text="Change PIN" />

        <Button
            android:id="@+id/save"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Save"
            android:visibility="gone" />
    </LinearLayout>

    <TextView
        android:id="@+id/msg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="#E15C6B"
        android:textSize="13sp" />
</LinearLayout>
