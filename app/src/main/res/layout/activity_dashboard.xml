<?xml version="1.0" encoding="utf-8"?>
<!-- Tier 2: behind the PIN. Everyday keyholder controls only — nothing here can
     end the arrangement. The irreversible actions live in activity_keyholder. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="28dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="Moto Guard"
            android:textColor="@color/text"
            android:textSize="26sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="control panel"
            android:textColor="@color/muted"
            android:textSize="13sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="24dp"
            android:padding="20dp"
            android:background="@drawable/bg_card">

            <TextView
                android:id="@+id/statusOwner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:text="Device owner: —" />

            <TextView
                android:id="@+id/statusKiosk"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:text="Kiosk: —" />

            <TextView
                android:id="@+id/statusKeyholder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/text"
                android:textSize="15sp"
                android:text="Keyholder: —" />

            <TextView
                android:id="@+id/statusPending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textColor="@color/accent"
                android:textSize="14sp"
                android:text="" />
        </LinearLayout>

        <!-- Receipts only. Setting this authorizes nothing, so it is safe at
             tier 2 — pointing it elsewhere only silences your own copies. -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Send my receipts to"
            android:textColor="@color/text"
            android:textSize="15sp" />

        <EditText
            android:id="@+id/ownerNumber"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_field"
            android:inputType="phone"
            android:textColor="@color/text"
            android:textColorHint="@color/muted"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:hint="your number (blank = off)" />

        <Button
            android:id="@+id/saveOwner"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="8dp"
            android:background="@drawable/btn_ghost"
            android:text="Save"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <TextView
            android:id="@+id/ownerMsg"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/accent"
            android:textSize="12sp" />

        <Button
            android:id="@+id/keyholder"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="28dp"
            android:background="@drawable/btn_ghost"
            android:text="Keyholder actions…"
            android:textAllCaps="false"
            android:textColor="@color/text" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Open or lock the kiosk, set the PIN, hand over, release. Each one texts the keyholder six digits to confirm."
            android:textColor="@color/muted"
            android:textSize="12sp" />

        <Button
            android:id="@+id/lock"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:layout_marginTop="24dp"
            android:background="@drawable/btn_primary"
            android:text="Lock now"
            android:textStyle="bold"
            android:textAllCaps="false"
            android:textColor="@color/onAccent" />
    </LinearLayout>
</ScrollView>
