<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- The kiosk face. Also registered as HOME so the home button can't escape it. -->
        <activity
            android:name=".GuardActivity"
            android:exported="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:stateNotNeeded="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- The app, behind the PIN wall. -->
        <activity
            android:name=".DashboardActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <activity
            android:name=".ChangePinActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- Tier 3: gated on the keyholder's code, not the PIN. -->
        <activity
            android:name=".KeyholderActivity"
            android:exported="false"
            android:excludeFromRecents="true" />

        <!-- Device Owner admin. -->
        <receiver
            android:name=".AdminReceiver"
            android:exported="true"
            android:permission="android.permission.BIND_DEVICE_ADMIN">
            <meta-data
                android:name="android.app.device_admin"
                android:resource="@xml/device_admin" />
            <intent-filter>
                <action android:name="android.app.action.DEVICE_ADMIN_ENABLED" />
            </intent-filter>
        </receiver>

        <!-- NO adb escape hatch. There used to be a secret broadcast that released
             the device; it was removed deliberately. An unlock reachable by the
             person carrying the phone would make the keyholder decorative. -->

        <!-- The keyholder's channel. Gated on BROADCAST_SMS (system-only) so no
             other app on the device can forge a command, then on the keyholder's
             number and code inside ControlApi. -->
        <receiver
            android:name=".SmsControlReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter android:priority="999">
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Re-assert policy after reboot. -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>
    </application>

    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Keyholder channel. Both are runtime permissions and the device is headless,
         so Policy.apply() self-grants them as Device Owner instead of prompting. -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
</manifest>
